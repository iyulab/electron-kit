{
  "name": "@iyulab/electron-kit",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dialogs": {
      "types": "./dist/dialogs.d.ts",
      "import": "./dist/dialogs.js"
    },
    "./app-menu": {
      "types": "./dist/app-menu.d.ts",
      "import": "./dist/app-menu.js"
    },
    "./updater": {
      "types": "./dist/updater.d.ts",
      "import": "./dist/updater.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "guard": "node scripts/check-forge-tokens.mjs",
    "guard:test": "node --test scripts/*.test.mjs"
  },
  "peerDependencies": {
    "electron": ">=28.0.0",
    "electron-updater": ">=6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "electron": "^42.5.2",
    "electron-updater": "^6.8.9",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
